{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "typecheck": {
      "inputs": ["src/**/*.ts", "test/**/*.ts", "tsconfig.json", "package.json"],
      "outputs": ["*.tsbuildinfo"]
    },
    "lint": {
      // biome.jsonc's `files.includes` is the scope `biome check .` walks, so
      // these globs mirror it exactly -- tsconfig.json and turbo.json are
      // linted too, and a key set only to src/**/*.ts replayed a green over an
      // edit to either.
      "inputs": ["src/**", "test/**", "*.json", "*.jsonc"],
      "outputs": []
    },
    "test": {
      // The suite reads three trees off disk that no source import reveals:
      // shipped specs under engines/, config.example.toml, and the install
      // script and unit templates under scripts/. Left out of the key, an edit
      // to any of them replays a green from assertions that never re-ran.
      "inputs": ["src/**/*.ts", "engines/**", "config.example.toml", "scripts/**", "package.json"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["typecheck"],
      // bun.lock is already part of turbo's dependency hash; naming it here is
      // explicit, not load-bearing.
      "inputs": ["src/**/*.ts", "tsconfig.json", "package.json", "bun.lock"],
      "outputs": ["dist/**"],
      "env": ["ENGINED_COMMIT"]
    }
  }
}
