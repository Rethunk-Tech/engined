{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "typecheck": {
      "inputs": ["src/**/*.ts", "test/**/*.ts", "tsconfig.json", "package.json"],
      "outputs": ["*.tsbuildinfo"]
    },
    "lint": {
      "inputs": ["src/**/*.ts", "test/**/*.ts", "biome.jsonc", "package.json"],
      "outputs": []
    },
    "test": {
      "inputs": ["src/**/*.ts", "scripts/install.sh", "package.json"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["typecheck"],
      "inputs": ["src/**/*.ts", "tsconfig.json", "package.json", "bun.lock"],
      "outputs": ["dist/**"],
      "env": ["ENGINED_COMMIT"]
    }
  }
}
