{
  "name": "engined",
  "version": "0.2.7",
  "private": true,
  "description": "Local model door: the sole owner of inference containers on one box",
  "license": "MIT",
  "homepage": "https://github.com/Rethunk-Tech/engined",
  "bugs": "https://github.com/Rethunk-Tech/engined/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/Rethunk-Tech/engined"
  },
  "keywords": [
    "bun",
    "daemon",
    "docker",
    "gpu",
    "inference",
    "llm",
    "local-first",
    "openai-compatible",
    "rocm",
    "self-hosted",
    "typescript"
  ],
  "type": "module",
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "schema": "bun -e \"await Bun.write('config.schema.json', (await import('./src/configSchema.ts')).renderConfigSchema())\"",
    "typecheck": "tsc -b --noEmit --pretty false && tsc -p src/configsvc/ui --noEmit --pretty false",
    "lint": "biome check . && knip",
    "format": "biome check --write .",
    "test": "bun test src --parallel=8 --randomize",
    "build": "rm -rf dist && bun build src/main.ts --target=bun --splitting --define ENGINED_COMMIT=\"\\\"${ENGINED_COMMIT:-unknown}\\\"\" --outdir=dist",
    "test:local": "ENGINED_LOCAL=1 ENGINED_BUNX=${ENGINED_BUNX:-$(command -v bunx)} /usr/bin/flock -w 3600 /tmp/engined-local-tier.lock bun test test/local",
    "ci": "turbo run typecheck lint test build",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.1",
    "@types/bun": "^1.4.3",
    "knip": "^6.41.0",
    "turbo": "^2.11.8",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.3",
  "dependencies": {
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@decimalturn/toml-patch": "3.3.0",
    "@lezer/highlight": "^1.2.5",
    "@preact/signals": "^2.11.3",
    "codemirror": "^6.0.2",
    "mermaid": "^12.2.0",
    "preact": "^11.0.1"
  },
  "patchedDependencies": {
    "@decimalturn/toml-patch@3.3.0": "patches/@decimalturn%2Ftoml-patch@3.3.0.patch"
  }
}
