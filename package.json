{
  "name": "engined",
  "version": "0.1.0",
  "private": true,
  "description": "Local model door: the sole owner of inference containers on one box",
  "license": "MIT",
  "homepage": "https://github.com/Rethunk-Tech/engined",
  "bugs": "https://github.com/Rethunk-Tech/engined/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/Rethunk-Tech/engined"
  },
  "keywords": [
    "bun",
    "daemon",
    "docker",
    "gpu",
    "inference",
    "llm",
    "local-first",
    "openai-compatible",
    "rocm",
    "self-hosted",
    "typescript"
  ],
  "type": "module",
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "typecheck": "tsc -b --noEmit --pretty false",
    "lint": "biome check . && knip",
    "format": "biome check --write .",
    "test": "bun test src",
    "build": "bun build src/main.ts --target=bun --define ENGINED_COMMIT=\"\\\"${ENGINED_COMMIT:-unknown}\\\"\" --outfile=dist/main.js",
    "test:local": "ENGINED_LOCAL=1 ENGINED_BUNX=${ENGINED_BUNX:-$(command -v bunx)} /usr/bin/flock -w 3600 /tmp/engined-local-tier.lock bun test test/local",
    "ci": "turbo run typecheck lint test build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "^1.4.2",
    "knip": "^6.39.0",
    "turbo": "^2.11.7",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.2"
}
