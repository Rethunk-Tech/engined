{
  "name": "engined",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -b --noEmit --pretty false",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test src",
    "build": "bun build src/main.ts --target=bun --outfile=dist/main.js",
    "test:local": "ENGINED_LOCAL=1 bun test test/local"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/bun": "^1.4.0",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.3.14"
}
