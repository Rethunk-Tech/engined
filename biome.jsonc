{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/.next",
      "!**/build",
      "!**/coverage",
      "!**/generated",
      "!**/.turbo",
      "!**/.venv",
      "!**/playwright-report",
      "!**/test-results",
      "!**/*.dc.html",
      "!**/*.min.js",
      "!**/vendor",
      "!**/public/pagefind",
      "!**/dist-release"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "all",
      "correctness": {
        "noSolidDestructuredProps": "off",
        "useQwikValidLexicalScope": "off",
        // engined is a daemon: node:os, node:path and node:child_process are
        // the intended surface, not a browser-bundle mistake.
        "noNodejsModules": "off"
      },
      "suspicious": {
        "noReactSpecificProps": "off"
      },
      "performance": {
        "useSolidForComponent": "off",
        "noJsxPropsBind": "off",
        // Measured 98% false-positive across the fleet: 131 of 134 sites were
        // correct sequential code. Here every loop it fires on is sequential
        // because the runtime demands it — readiness and render polls that
        // must not fire every attempt at once, single-reader stream and
        // async-generator drains, a chain whose next hop consumes the
        // previous one's output, and engine probes that would otherwise load
        // several models into one GPU concurrently.
        "noAwaitInLoops": "off"
      },
      "style": {
        "noTernary": "off",
        "noNestedTernary": "off",
        "noMagicNumbers": "off",
        "noJsxLiterals": "off",
        "noContinue": "off",
        "noIncrementDecrement": "off",
        "useDestructuring": "off",
        "useExportsLast": "off",
        "useExplicitLengthCheck": "off",
        "useErrorCause": "off",
        "useNamingConvention": "off",
        "useFilenamingConvention": "off",
        "noProcessEnv": "off",
        "noExcessiveLinesPerFile": {
          "level": "on",
          "options": {
            "maxLines": 500
          }
        }
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": "off",
        "noExcessiveLinesPerFunction": "off"
      },
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error"
      }
    }
  },
  "javascript": {
    // Bun's runtime global is ambient, supplied by @types/bun rather than an import.
    "globals": ["Bun"]
  },
  "overrides": [
    {
      "includes": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/test/**",
        "**/__tests__/**"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off",
            "noProcessGlobal": "off",
            "noUnresolvedImports": "off"
          },
          "security": { "noSecrets": "off" },
          "performance": { "useTopLevelRegex": "off" },
          "suspicious": {
            "noBitwiseOperators": "off",
            "noMisplacedAssertion": "off",
            "noSkippedTests": "off",
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["**/e2e/**", "**/playwright.config.ts", "**/playwright.*.config.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off",
            "noProcessGlobal": "off",
            "noUnresolvedImports": "off"
          },
          "security": { "noSecrets": "off" },
          "performance": { "useTopLevelRegex": "off" },
          "suspicious": { "noConsole": "off" }
        }
      }
    },
    {
      "includes": [
        "**/scripts/**",
        "tools/**",
        "**/*.config.ts",
        "**/*.config.mjs",
        "**/*.config.js"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off",
            "noProcessGlobal": "off",
            "noUnresolvedImports": "off"
          },
          "performance": { "useTopLevelRegex": "off" },
          "suspicious": { "noConsole": "off" }
        }
      }
    },
    {
      "includes": [
        "**/src/server/**",
        "**/apps/server/**",
        "**/apps/worker/**",
        "**/app/**/route.ts",
        "**/src/app/api/**"
      ],
      "linter": {
        "rules": { "correctness": { "noNodejsModules": "off", "noProcessGlobal": "off" } }
      }
    }
  ],
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
