{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/.next",
      "!**/build",
      "!**/coverage",
      "!**/generated",
      "!**/.turbo",
      "!**/.venv",
      "!**/playwright-report",
      "!**/test-results",
      "!**/*.dc.html",
      "!**/*.min.js",
      "!**/vendor",
      "!**/public/pagefind",
      "!**/dist-release"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "all",
      "correctness": {
        "noNodejsModules": "off",
        "noSolidDestructuredProps": "off",
        "useQwikValidLexicalScope": "off"
      },
      "suspicious": {
        "noReactSpecificProps": "off"
      },
      "performance": {
        "noAwaitInLoops": "off",
        "noJsxPropsBind": "off",
        "useSolidForComponent": "off"
      },
      "style": {
        "noTernary": "off",
        "noNestedTernary": "off",
        "noMagicNumbers": "off",
        "noJsxLiterals": "off",
        "noContinue": "off",
        "noIncrementDecrement": {
          "level": "on",
          "options": {
            "allowForLoopAfterthoughts": true
          }
        },
        "useDestructuring": "off",
        "useExportsLast": "off",
        "useExplicitLengthCheck": "off",
        "useErrorCause": "off",
        "useNamingConvention": "off",
        "useFilenamingConvention": {
          "level": "on",
          "options": {
            "strictCase": false,
            "filenameCases": ["camelCase", "PascalCase", "kebab-case", "export"]
          }
        },
        "noProcessEnv": "off",
        "noExcessiveLinesPerFile": {
          "level": "on",
          "options": {
            "maxLines": 500
          }
        }
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "on",
          "options": {
            "maxAllowedComplexity": 25
          }
        },
        "noExcessiveLinesPerFunction": {
          "level": "on",
          "options": {
            "maxLines": 100,
            "skipBlankLines": true,
            "skipIifes": true
          }
        }
      },
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error"
      }
    },
    "domains": {
      "qwik": "none",
      "solid": "none"
    }
  },
  "javascript": {
    // Bun's runtime global is ambient, supplied by @types/bun rather than an import.
    "globals": ["Bun"]
  },
  "overrides": [
    {
      "includes": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/test/**",
        "**/__tests__/**"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off",
            "noProcessGlobal": "off",
            "noUnresolvedImports": "off"
          },
          "security": { "noSecrets": "off" },
          "performance": { "useTopLevelRegex": "off" },
          // A test file's length is the number of cases it covers for one unit,
          // and its fakes are the doubles those cases drive -- neither is a
          // second job the file has taken on.
          "style": {
            "noExcessiveLinesPerFile": {
              "level": "on",
              "options": {
                "maxLines": 1500
              }
            },
            "noExcessiveClassesPerFile": "off",
            "noMagicNumbers": "off",
            "noProcessEnv": "off"
          },
          "suspicious": {
            "noBitwiseOperators": "off",
            "noMisplacedAssertion": "off",
            "noSkippedTests": "off",
            "noConsole": "off"
          },
          "complexity": {
            "noExcessiveCognitiveComplexity": {
              "level": "on",
              "options": {
                "maxAllowedComplexity": 30
              }
            },
            "noExcessiveLinesPerFunction": {
              "level": "on",
              "options": {
                "maxLines": 150,
                "skipBlankLines": true,
                "skipIifes": true
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/e2e/**", "**/playwright.config.ts", "**/playwright.*.config.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off",
            "noProcessGlobal": "off",
            "noUnresolvedImports": "off"
          },
          "security": { "noSecrets": "off" },
          "performance": { "useTopLevelRegex": "off" },
          "suspicious": {
            "noConsole": "off"
          },
          "style": {
            "noDefaultExport": "off",
            "noMagicNumbers": "off",
            "noProcessEnv": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/scripts/**",
        "tools/**",
        "**/*.config.ts",
        "**/*.config.mjs",
        "**/*.config.js"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off",
            "noProcessGlobal": "off",
            "noUnresolvedImports": "off"
          },
          "performance": { "useTopLevelRegex": "off" },
          "suspicious": {
            "noConsole": "off"
          },
          "style": {
            "noDefaultExport": "off",
            "noProcessEnv": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/src/server/**",
        "**/apps/server/**",
        "**/apps/worker/**",
        "**/app/**/route.ts",
        "**/src/app/api/**"
      ],
      "linter": {
        "rules": { "correctness": { "noNodejsModules": "off", "noProcessGlobal": "off" } }
      }
    },
    {
      // One class each, whose private state cross-cuts every method family:
      // DockerLifecycle's runtime map, per-engine start locks, leases and
      // holds; EngineRegistry's entries, statuses and watchers; LlamaRouter's
      // per-role occupancy and its single in-flight ensure-started promise.
      // Everything separable was separated -- command-line construction, entry
      // building, the agentic version proof, the presets INI -- and what is
      // left cannot be cut without threading that state through an invented
      // signature or dissolving the class.
      "includes": ["src/docker.ts", "src/engines.ts", "src/llama.ts"],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": { "level": "on", "options": { "maxLines": 800 } }
          }
        }
      }
    }
  ],
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
