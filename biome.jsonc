{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "includes": ["src/**", "test/**", "*.json", "*.jsonc"] },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "all",
      "correctness": {
        // engined is a daemon: node:os, node:path and node:child_process are
        // the intended surface, not a browser-bundle mistake.
        "noNodejsModules": "off",
        // Bun's globals come from @types/bun rather than a package import.
        "noUndeclaredDependencies": "off",
        // Biome does not resolve Bun's builtin `bun:` module scheme (bun:test).
        "noUnresolvedImports": "off",
        // A framework rule from the preset. There is no Qwik here, and it fires
        // on any module-scope async arrow with an explicit return type.
        "useQwikValidLexicalScope": "off"
      },
      "style": {
        // Resolving XDG_CONFIG_HOME/DATA/STATE is a required behaviour here.
        "noProcessEnv": "off",
        // TOML keys are snake_case and pass through untouched, so the config
        // and spec shapes cannot be renamed to satisfy a casing rule.
        "useNamingConvention": "off",
        "noTernary": "off",
        "noContinue": "off",
        "noIncrementDecrement": "off",
        "noParameterProperties": "off",
        "noExcessiveClassesPerFile": "off",
        "useExportsLast": "off",
        "useConsistentArrayType": "off",
        // A file's length is not a defect. Splitting config parse or the
        // container lifecycle to hit a line count would scatter one concern
        // across several files to satisfy a metric.
        "noExcessiveLinesPerFile": "off",
        // The rule only recognises a cause in the second argument. ParseError
        // is (message, file, options), so a correctly-threaded cause in the
        // third position reads to it as a missing one.
        "useErrorCause": "off"
      },
      "performance": {
        // Readiness polls, idle waits and retry loops are sequential by
        // definition -- awaiting them concurrently would fire every attempt at
        // once, which is the opposite of what a poll is.
        "noAwaitInLoops": "off"
      },
      "suspicious": {
        // engined's environment comes from a systemd unit, not a .env file, so
        // there is no manifest for this rule to check a name against.
        "noUndeclaredEnvVars": "off"
      },
      "nursery": { "preset": "none" }
    }
  },
  "javascript": {
    // Bun's runtime global is ambient, supplied by @types/bun rather than an import.
    "globals": ["Bun"]
  },
  "overrides": [
    {
      // A literal status code or byte count is the assertion in a test; naming
      // it moves the value away from the line that checks it.
      "includes": ["**/*.test.ts"],
      "linter": {
        "rules": {
          "style": { "noMagicNumbers": "off" },
          // A test skipped with its blocker named is this project's way of
          // shipping an unmet acceptance criterion honestly. The rule's unsafe
          // fix removes the marker, which turns a documented gap into a
          // failing suite.
          "suspicious": { "noSkippedTests": "off" }
        }
      }
    }
  ],
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
