{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/.next",
      "!**/build",
      "!**/coverage",
      "!**/generated",
      "!**/.turbo",
      "!**/.venv",
      "!**/playwright-report",
      "!**/test-results",
      "!**/*.dc.html",
      "!**/*.min.js",
      "!**/vendor",
      "!**/public/pagefind",
      "!**/dist-release",
      "!.claude",
      "!**/database.types.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "linter": {
    "rules": {
      "preset": "all",
      "correctness": {
        "noSolidDestructuredProps": "off",
        "useQwikValidLexicalScope": "off",
        "noUnresolvedImports": "off"
      },
      "suspicious": {
        "noReactSpecificProps": "off",
        "noExplicitAny": "error"
      },
      "performance": {
        "noAwaitInLoops": "off",
        "noJsxPropsBind": "off",
        "useSolidForComponent": "off"
      },
      "style": {
        "noTernary": "off",
        "noNestedTernary": "off",
        "noMagicNumbers": "off",
        "noJsxLiterals": "off",
        "noContinue": "off",
        "noIncrementDecrement": {
          "level": "on",
          "options": {
            "allowForLoopAfterthoughts": true
          }
        },
        "useDestructuring": "off",
        "useExportsLast": "off",
        "useExplicitLengthCheck": "off",
        "useErrorCause": "off",
        "useNamingConvention": {
          "level": "on",
          "options": {
            "strictCase": false,
            "conventions": [
              {
                "selector": {
                  "kind": "objectLiteralProperty"
                },
                "match": "_?\\$?(.+)",
                "formats": ["camelCase", "snake_case", "CONSTANT_CASE", "PascalCase"]
              },
              {
                "selector": {
                  "kind": "typeProperty"
                },
                "match": "_?\\$?(.+)",
                "formats": ["camelCase", "snake_case", "CONSTANT_CASE"]
              }
            ]
          }
        },
        "useFilenamingConvention": {
          "level": "on",
          "options": {
            "strictCase": false,
            "filenameCases": ["camelCase", "PascalCase", "kebab-case", "export"]
          }
        },
        "noProcessEnv": "off",
        "noExcessiveLinesPerFile": {
          "level": "on",
          "options": {
            "maxLines": 500
          }
        },
        "useImportType": "error",
        "noNonNullAssertion": "error"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "on",
          "options": {
            "maxAllowedComplexity": 25
          }
        },
        "noExcessiveLinesPerFunction": {
          "level": "on",
          "options": {
            "maxLines": 100,
            "skipBlankLines": true,
            "skipIifes": true
          }
        },
        "noUselessUndefined": "off"
      },
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error"
      }
    }
  },
  "javascript": {
    // Bun's runtime global is ambient, supplied by @types/bun rather than an import.
    "globals": ["Bun"],
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "all"
    }
  },
  "overrides": [
    // canon ts-biome-00015 — test files
    {
      "includes": [
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/__tests__/**",
        "**/test/**"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": {
              "level": "on",
              "options": {
                "maxAllowedComplexity": 30
              }
            },
            "noExcessiveLinesPerFunction": {
              "level": "on",
              "options": {
                "maxLines": 150,
                "skipBlankLines": true,
                "skipIifes": true
              }
            }
          },
          "correctness": {
            "noNodejsModules": "off",
            "noProcessGlobal": "off",
            "noUnresolvedImports": "off"
          },
          "performance": {
            "noNamespaceImport": "off",
            "useTopLevelRegex": "off"
          },
          "security": {
            "noSecrets": "off"
          },
          "style": {
            "noExcessiveLinesPerFile": {
              "level": "on",
              "options": {
                "maxLines": 1500
              }
            },
            "noMagicNumbers": "off",
            "noProcessEnv": "off",
            "useComponentExportOnlyModules": "off"
          },
          "suspicious": {
            "noBitwiseOperators": "off",
            "noConsole": "off",
            "noMisplacedAssertion": "off",
            "noSkippedTests": "off",
            "useAwait": "off"
          }
        }
      }
    },
    {
      "includes": ["**/e2e/**", "**/playwright.config.ts", "**/playwright.*.config.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off",
            "noProcessGlobal": "off",
            "noUnresolvedImports": "off"
          },
          "security": { "noSecrets": "off" },
          "performance": { "useTopLevelRegex": "off" },
          "suspicious": {
            "noConsole": "off"
          },
          "style": {
            "noDefaultExport": "off",
            "noMagicNumbers": "off",
            "noProcessEnv": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/scripts/**",
        "tools/**",
        "**/*.config.ts",
        "**/*.config.mjs",
        "**/*.config.js"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off",
            "noProcessGlobal": "off",
            "noUnresolvedImports": "off"
          },
          "performance": { "useTopLevelRegex": "off" },
          "suspicious": {
            "noConsole": "off"
          },
          "style": {
            "noDefaultExport": "off",
            "noProcessEnv": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/src/server/**",
        "**/apps/server/**",
        "**/apps/worker/**",
        "**/app/**/route.ts",
        "**/src/app/api/**"
      ],
      "linter": {
        "rules": { "correctness": { "noNodejsModules": "off", "noProcessGlobal": "off" } }
      }
    },
    {
      // A Bun daemon: tsconfig.json states lib ESNext, so none of this reaches a browser.
      "includes": ["src/**", "test/**"],
      "linter": { "rules": { "correctness": { "noNodejsModules": "off" } } }
    },
    {
      "includes": ["**/*.d.ts"],
      "linter": { "rules": { "style": { "noDefaultExport": "off" } } }
    },
    {
      "includes": ["**/cli.ts", "**/logger.ts", "**/log.ts", "**/main.ts"],
      "linter": { "rules": { "suspicious": { "noConsole": "off" } } }
    },
    {
      // One class each, whose private state cross-cuts every method family:
      // DockerLifecycle's runtime map, per-engine start locks, leases and
      // holds; EngineRegistry's entries, statuses and watchers; LlamaRouter's
      // per-role occupancy and its single in-flight ensure-started promise.
      // Everything separable was separated -- command-line construction, entry
      // building, the agentic version proof, the presets INI -- and what is
      // left cannot be cut without threading that state through an invented
      // signature or dissolving the class.
      "includes": ["src/docker.ts", "src/engines.ts", "src/llama.ts"],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": { "level": "on", "options": { "maxLines": 800 } }
          }
        }
      }
    }
  ],
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
