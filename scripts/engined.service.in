[Unit]
Description=engined — local model door
After=network.target

[Service]
Type=simple
ExecStart=@BUN_PATH@ @INSTALL_DIR@/main.js

# A held port or bad config must stop, not loop: Restart=on-failure alone
# turns both into a restart loop whose reason lives only in journald.
# engined exits 78 for anything a restart cannot fix.
Restart=on-failure
RestartPreventExitStatus=78

# {bunx} in a spec.toml command resolves to this at render time.
Environment=ENGINED_BUNX=@BUNX_PATH@

# ProtectHome=read-only makes bunx fail "Unexpected accessing temporary
# directory" without naming the sandbox as the cause. The cache this points
# at is hundreds of megabytes for this one package, and bunx's own default
# landing site is under /tmp -- a tmpfs cleared every reboot even without
# PrivateTmp, which gives the unit its own on top of that. Point both at the
# one writable path so a cold start doesn't re-download all of it before the
# first token.
Environment=BUN_INSTALL=@STATE_DIR@/bun-install
Environment=BUN_TMPDIR=@STATE_DIR@/tmp

# The read-only guarantee lives here, not in engined's own launch flags.
# Measured under exactly these directives (ProtectSystem=strict,
# ReadWritePaths=@STATE_DIR@, ProtectHome=read-only, PrivateTmp=yes,
# BindPaths=/tmp below): a write to a fleet repository under $HOME and to
# one outside it both fail EROFS, the state directory stays writable, and
# `docker` still reaches /var/run/docker.sock -- connecting to a socket is
# not a filesystem write, so a read-only /var costs nothing. ProtectHome
# alone would not do it: all but two of this fleet's working trees are
# outside $HOME, and only ProtectSystem=strict reaches them.
#
# This cannot become a test. A `bun test` process never runs inside this
# unit's sandbox, and hand-rolling an equivalent means a second maintained
# copy of these directives -- the exact two-definitions drift this repo
# keeps getting bitten by. This comment, re-verified against a live systemd
# run, is the only durable record of a check that has to stay manual.
ProtectSystem=strict
ReadWritePaths=@STATE_DIR@
ProtectHome=read-only
NoNewPrivileges=yes
PrivateTmp=yes

# An agentic `workdir` is caller-supplied and routinely lands under /tmp (the
# `mktemp -d` default). PrivateTmp's private /tmp hides that real directory
# from the unit, so node:child_process's spawn() gets a nonexistent cwd and
# misreports it as ENOENT on the spawned executable itself -- reading as
# "bunx vanished" when bunx was never the problem. Bind the real /tmp back in
# so those workdirs resolve; PrivateTmp still isolates /var/tmp.
BindPaths=/tmp

# MemoryDenyWriteExecute is deliberately absent: Bun's JIT and the
# subprocesses engined spawns both need W^X.

[Install]
WantedBy=default.target
