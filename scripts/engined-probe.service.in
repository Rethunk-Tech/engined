[Unit]
Description=engined — acceptance probes
# The probe is an ordinary caller on loopback, so there is nothing to talk to
# until the door is up. Not Requires=: a box where the door is deliberately
# stopped should skip a probe run, not drag the daemon back up to answer it.
After=engined.service
ConditionPathExists=@INSTALL_DIR@/main.js

[Service]
Type=oneshot
ExecStart=@BUN_PATH@ @INSTALL_DIR@/main.js --probe

# The probe reads the same config the daemon does, and dispatches through the
# door rather than launching anything itself, so it needs neither the door's
# state directory nor its docker access.
ProtectSystem=strict
ProtectHome=read-only
NoNewPrivileges=yes
PrivateTmp=yes
