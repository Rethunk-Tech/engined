# TLS in front of engined, which stays cleartext.
#
# cursor-agent boots over HTTP/1.1 and then opens `AgentService/Run` over
# HTTP/2, negotiating with ALPN -- which only a TLS listener can do. engined
# therefore serves two cleartext backends and this proxy routes by path:
# the turn stream to the h2c listener, everything else to the door.
#
# `cursor-agent` trusts Caddy's internal CA. On a host `caddy` binary:
#   NODE_EXTRA_CA_CERTS=$(caddy environ | grep -i pki)/authorities/local/root.crt
# `caddy environ` is that binary's own environment, not a containerised
# Caddy's; if Caddy runs in a container, point NODE_EXTRA_CA_CERTS at the
# volume that holds the same root.crt, or any cert the operator chooses.
# It is a Node bundle, so no system trust store change is needed.

{
	auto_https disable_redirects
	# The container shares the host network, so Caddy's admin API would sit on the host's
	# 127.0.0.1:2019 where any local process could rewrite the proxy. Nothing here reloads
	# Caddy through it: engined-tls re-renders this file and restarts the container instead.
	admin off
}

engined.localhost:29443 {
	tls internal

	@run path /agent.v1.AgentService/Run
	reverse_proxy @run h2c://127.0.0.1:29201

	reverse_proxy 127.0.0.1:29200
}

# @CONFIGSVC_SITE@
